# Copy to .env (never commit .env). Pick ONE option. Lines starting with # are ignored.
# With no key at all the app runs in regex-only mode, fully offline.

# ---- Option B: free OpenAI-compatible API (Groq shown; no credit card) ----
LLM_PROVIDER=openai
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=openai/gpt-oss-120b

# ---- Option A: Google Gemini (remove the Option B lines above first) ----
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.5-flash

# regex | gemini | hybrid. "gemini" means "LLM only" for either provider.
# Leave unset: hybrid when a key is set, otherwise regex.
# EXTRACTOR=hybrid
